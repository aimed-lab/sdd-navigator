# Copy this to .env and fill in. Reuse the SAME Groq key the Next.js app uses
# (frontend/.env.local -> GROQ_API_KEY) — do not mint a new one.

# ── LLM (provider-agnostic wrapper; see llm.py) ──────────────────────────────
LLM_PROVIDER=groq                     # "groq" (default) | "openai"
LLM_MODEL=llama-3.3-70b-versatile     # model id for the chosen provider
LLM_API_KEY=                          # optional; if unset, falls back to GROQ_API_KEY
GROQ_API_KEY=                         # required (also the LLM_API_KEY fallback)

# ── Supabase (READ-ONLY; used by search_lab_resources) ───────────────────────
SUPABASE_URL=
SUPABASE_KEY=                         # service-role key (same value as backend/.env)

# ── Upstream API auth (ALL OPTIONAL) ─────────────────────────────────────────
# Every one of these is optional: unset, the corresponding source still works
# unauthenticated, just at a lower rate limit. Set them in deployment — a single
# shared instance burns through the anonymous ceilings quickly.

# PubMed / NCBI E-utilities. 3 req/sec anonymous -> 10 req/sec with a key.
# Free: https://account.ncbi.nlm.nih.gov/settings/ (API Key Management)
NCBI_API_KEY=

# OpenAlex "polite pool" — an email identifies the traffic and buys faster,
# more consistent service (and avoids being throttled with the anonymous pool).
# Any real contact address you own; no signup required.
OPENALEX_EMAIL=

# GitHub repo search. search_tools hits /search/repositories, which uses
# GitHub's SEARCH bucket: 10 req/MINUTE anonymous -> 30 req/MINUTE authenticated.
# (The familiar 60/hr -> 5000/hr figure is the CORE bucket and does not apply
# to search.) A fine-grained token with NO scopes is enough (public read only).
GITHUB_TOKEN=

# ── Landing-feed pre-warm ────────────────────────────────────────────────────
# On startup (and then on an interval) the server runs explore("") so the blank
# landing feed — what every first visitor hits — is already a cache hit. Turn it
# OFF locally if you don't want a dev server calling six upstream APIs on boot.
PREWARM_ENABLED=1
# Seconds between refreshes. Must be SHORTER than the feed's 10-min fresh TTL or
# the entry goes stale between runs; values above that are clamped.
PREWARM_INTERVAL_SEC=480

# ── MCP server ───────────────────────────────────────────────────────────────
MCP_PORT=8000
# MCP_HOST=0.0.0.0
