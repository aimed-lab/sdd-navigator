# Copy this to .env and fill in. See DEPLOY.md for what each variable does,
# which are required, and where the outside-UAB reachability requirement
# comes from. Reuse the SAME Groq key the Next.js app uses (frontend/
# .env.local -> GROQ_API_KEY) — do not mint a new one.

# ── LLM (provider-agnostic wrapper; see llm.py) ──────────────────────────────
LLM_PROVIDER=                         # optional; "groq" (default) | "openai"
LLM_MODEL=                            # optional; model id for the chosen provider (default llama-3.3-70b-versatile)
LLM_API_KEY=                          # optional; if unset, falls back to GROQ_API_KEY
GROQ_API_KEY=                         # required (also the LLM_API_KEY fallback)

# ── Supabase (READ-ONLY; used by search_lab_resources/search_people/search_wiki) ──
SUPABASE_URL=                         # required
SUPABASE_KEY=                         # required; service-role key (same value as backend/.env)

# ── Upstream API auth (ALL OPTIONAL) ─────────────────────────────────────────
# Every one of these is optional: unset, the corresponding source still works
# unauthenticated, just at a lower rate limit. Set them in deployment — a single
# shared instance burns through the anonymous ceilings quickly.
NCBI_API_KEY=                         # optional; PubMed/GEO E-utilities, raises 3 req/sec -> 10 req/sec
OPENALEX_EMAIL=                       # optional; OpenAlex "polite pool", any real contact address
GITHUB_TOKEN=                         # optional; GitHub repo search, raises 10 req/min -> 30 req/min

# ── Landing-feed pre-warm ────────────────────────────────────────────────────
PREWARM_ENABLED=                      # optional; "1"/"true"/"yes" (default on); set to 0 to disable
PREWARM_INTERVAL_SEC=                 # optional; seconds between refreshes (default 480)
PREWARM_TIMEOUT_SEC=                  # optional; max seconds one warm attempt may run (default 20)

# ── MCP server ───────────────────────────────────────────────────────────────
MCP_HOST=                             # optional; default 0.0.0.0 — leave unset in a container
MCP_PORT=                             # optional; default 8000
LOG_LEVEL=                            # optional; default INFO (DEBUG/INFO/WARNING/ERROR)
