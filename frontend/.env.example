# Copy to .env.local and fill in.

# ── Supabase (client, cookie-based auth) ─────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Explore backend (Python explore-mcp) ─────────────────────────────────────
# Base URL the /api/explore proxy forwards to. Default is the local dev server.
EXPLORE_API_URL=http://localhost:8000
