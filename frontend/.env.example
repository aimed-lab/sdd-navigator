# Copy to .env.local and fill in.

# ── Supabase (client, cookie-based auth) ─────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Explore backend (Python explore-mcp) ─────────────────────────────────────
# Base URL the /api/explore, /api/papers and /api/project-agent/* proxies
# forward to. Default is the local dev server.
EXPLORE_API_URL=http://localhost:8000
# Bearer token sent as `Authorization: Bearer <token>` on every backend call
# (see lib/server/exploreBackend.ts). SERVER-ONLY — deliberately no
# NEXT_PUBLIC_ prefix; that prefix is what ships a var into the browser
# bundle, and this token must never reach one. Must match the backend's own
# EXPLORE_API_TOKEN to enable auth. Optional: leave both unset for local dev
# against an unauthenticated backend — nothing here fails to build without it.
EXPLORE_API_TOKEN=
